# SilkWarp Server & Deployment Environment Configuration Template
# Copy to secrets/silkwarp.env (git-ignored) and fill in your real values before deploying.

# Public domains & signaling/relay endpoints
SILKWARP_API_URL=https://silkwarp.example.com/silkwarp
SILKWARP_DOMAIN=silkwarp.example.com
SILKWARP_SIGNALING_HOST=203.0.113.10
SILKWARP_RELAY_HOST=relay.example.com

# Service ports
SILKWARP_EASYTIER_COORD_PORT=11010
SILKWARP_EASYTIER_RELAY_PORT=11011
SILKWARP_RUSTDESK_HBBS_PORT=21116
SILKWARP_RUSTDESK_HBBR_PORT=21117
SILKWARP_RUSTDESK_API_URL=https://silkwarp.example.com:21114
SILKWARP_RUSTDESK_API_PORT=21114

# Control plane & Nginx integration (Aliyun / VPS)
SILKWARP_CP_PORT=18800
SILKWARP_CP_PATH=/silkwarp
SILKWARP_SSL_CERT=/etc/nginx/ssl/silkwarp.example.com/fullchain.pem
SILKWARP_SSL_KEY=/etc/nginx/ssl/silkwarp.example.com/privkey.pem
SILKWARP_NGINX_SITE=
SILKWARP_NGINX_ANCHOR=

# EasyTier mesh & Wake-on-LAN gateway
SILKWARP_MESH_CIDR=10.144.0.0/24
SILKWARP_RELAY_MESH_IP=10.144.0.1
SILKWARP_WOL_PORT=9580
SILKWARP_WOL_BROADCAST=255.255.255.255
SILKWARP_NETWORK_NAME=silkwarp-team
SILKWARP_NETWORK_SECRET=replace-with-strong-team-secret
SILKWARP_COORD_NETWORK_NAME=silkwarp-coord-only
SILKWARP_COORD_SECRET=replace-with-strong-coord-secret
SILKWARP_WOL_TOKEN=replace-with-strong-wol-token

# RustDesk public key (generated by hbbs on first run)
RUSTDESK_PUBLIC_KEY=replace-with-rustdesk-id-ed25519-pub

# Control plane admin & session secret
SILKWARP_ADMIN_USER=admin
SILKWARP_ADMIN_PASSWORD=replace-with-strong-admin-password
SILKWARP_SESSION_SECRET=replace-with-random-session-secret
