# SilkWarp EasyTier Host / Client Node Template
# Host PCs: assign static mesh IP (e.g. "10.144.0.10/24", dhcp = false).
# Roaming clients: remove `ipv4` and set `dhcp = true` (or assign fixed IP like 10.144.0.101/24).

hostname = "silkwarp-node-example"
ipv4 = "10.144.0.10/24"
dhcp = false

listeners = [
    "tcp://0.0.0.0:0",
    "udp://0.0.0.0:0",
    "tcp://[::]:0",
    "udp://[::]:0",
]

rpc_portal = "127.0.0.1:15888"

[[peer]]
uri = "udp://relay.example.com:11011"

[[peer]]
uri = "tcp://relay.example.com:11011"

[[peer]]
uri = "udp://signaling.example.com:11010"

[[peer]]
uri = "tcp://signaling.example.com:11010"

[network_identity]
network_name = "silkwarp-team"
network_secret = "<REPLACE_WITH_SILKWARP_NETWORK_SECRET>"

[flags]
latency_first = true
multi_thread = true
enable_ipv6 = true
enable_encryption = true
